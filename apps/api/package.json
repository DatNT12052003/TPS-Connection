{
  "name": "@tps/api",
  "version": "0.0.0",
  "private": true,
  "description": "API của TPS-Connection: Express + TypeORM + PostgreSQL + Redis.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns \"\\.int\\.test\\.ts$\"",
    "db:migrate": "node --env-file-if-exists=.env --import tsx ../../node_modules/typeorm/cli.js migration:run -d src/db/cli-data-source.ts",
    "db:revert": "node --env-file-if-exists=.env --import tsx ../../node_modules/typeorm/cli.js migration:revert -d src/db/cli-data-source.ts",
    "db:status": "node --env-file-if-exists=.env --import tsx ../../node_modules/typeorm/cli.js migration:show -d src/db/cli-data-source.ts",
    "db:migration:create": "typeorm migration:create",
    "db:migration:generate": "node --env-file-if-exists=.env --import tsx ../../node_modules/typeorm/cli.js migration:generate -p -d src/db/cli-data-source.ts",
    "db:seed:areas": "node --env-file-if-exists=.env --import tsx src/db/seeds/seed-areas.ts",
    "users:staff": "node --env-file-if-exists=.env --import tsx src/cli/staff.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@tps/shared": "^0.0.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@tps/config": "^0.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  }
}
