                    },
                    "displayName": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "tutor",
                        "parent",
                        "student",
                        "manager",
                        "admin"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "vi",
                        "en"
                      ]
                    },
                    "emailVerified": {
                      "type": "boolean"
                    },
                    "phone": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "displayName",
                    "role",
                    "locale",
                    "emailVerified",
                    "phone",
                    "avatarUrl"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change display name, phone, language or avatar",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "phone": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^\\+?[0-9][0-9 .-]{7,19}$"
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "vi",
                      "en"
                    ]
                  },
                  "avatarFileId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "tutor",
                        "parent",
                        "student",
                        "manager",
                        "admin"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "vi",
                        "en"
                      ]
                    },
                    "emailVerified": {
                      "type": "boolean"
                    },
                    "phone": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "displayName",
                    "role",
                    "locale",
                    "emailVerified",
                    "phone",
                    "avatarUrl"
                  ]
                }
