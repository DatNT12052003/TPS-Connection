# Copy to .env for local development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Used by the running application. Limited privileges.
DATABASE_URL=postgres://tps_app:tps_app_dev@localhost:5433/tps
# Used only by migrations and seeds. Owns the schema.
MIGRATION_DATABASE_URL=postgres://tps_owner:tps_owner_dev@localhost:5433/tps
# Comma-separated list of Web origins allowed by CORS.
WEB_ORIGINS=http://localhost:5173
# Signs session tokens. At least 32 characters. Generate a real one for any shared
# environment: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=local-development-only-not-a-real-secret
# Base URL of apps/web, used in links inside emails.
WEB_BASE_URL=http://localhost:5173
# Mailpit from docker-compose. Open http://localhost:8025 to read the emails.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TPS-Connection <no-reply@tps-connection.local>
