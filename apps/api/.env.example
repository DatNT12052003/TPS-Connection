# Cấu hình API cho máy local. Chép thành apps/api/.env:  cp apps/api/.env.example apps/api/.env
# Giá trị dưới đây khớp với Docker Compose (npm run infra:up). API kiểm tra mọi biến khi khởi động
# (src/config/env.ts) và dừng ngay nếu thiếu hoặc sai.

NODE_ENV=development
# 127.0.0.1: chỉ máy này truy cập được. Trên máy chủ (Docker) đặt 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL trong Docker chạy ở cổng 5433 (xem compose.yaml).
DATABASE_URL=postgres://tps:tps_dev_password@127.0.0.1:5433/tps
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6379

# Địa chỉ web được phép gọi API (CORS), phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173

# Kho lưu tệp: SeaweedFS trong Docker (D53). Khóa khớp docker/seaweedfs/s3.json (chỉ dùng cho máy local).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=tps_dev_access_key
S3_SECRET_KEY=tps_dev_secret_key_change_me
S3_BUCKET_PUBLIC=tps-public
S3_BUCKET_PRIVATE=tps-private
# URL trình duyệt dùng để đọc tệp public; bỏ trống thì là <S3_ENDPOINT>/<S3_BUCKET_PUBLIC>.
S3_PUBLIC_BASE_URL=
S3_CONFIGURE_CORS=true

# Email: Mailpit trong Docker nhận mọi tài khoản; xem thư ở http://127.0.0.1:8025.
# Chạy thật với Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<gmail của hệ thống>, SMTP_PASS=<App Password>, EMAIL_FROM trùng SMTP_USER.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev
EMAIL_FROM="TPS-Connection <no-reply@tps-connection.local>"

# Worker BullMQ (gửi email, job định kỳ) chạy cùng tiến trình API.
WORKERS_ENABLED=true

# Xác thực (G2). Giá trị dưới đây CHỈ dùng cho máy local. Chạy thật: tạo khóa ngẫu nhiên, ví dụ
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0001
OTP_SECRET=dev-only-otp-secret-do-not-use-in-production-0001
# Cookie đăng nhập: bỏ trống domain khi chạy local (web và API cùng là localhost).
# Chạy thật: COOKIE_DOMAIN=<tên miền gốc>, COOKIE_SECURE=true (bắt buộc khi NODE_ENV=production).
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Tin reverse proxy nào để lấy IP thật (rate limit). Xem "trust proxy" của Express.
TRUST_PROXY=loopback
