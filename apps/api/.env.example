# Copy to .env for local development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Used by the running application. Limited privileges.
DATABASE_URL=postgres://tps_app:tps_app_dev@localhost:5433/tps
# Used only by migrations and seeds. Owns the schema.
MIGRATION_DATABASE_URL=postgres://tps_owner:tps_owner_dev@localhost:5433/tps
# Comma-separated list of Web origins allowed by CORS.
WEB_ORIGINS=http://localhost:5173
