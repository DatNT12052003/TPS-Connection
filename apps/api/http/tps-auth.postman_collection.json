              "const query = encodeURIComponent('to:\"' + pm.collectionVariables.get('email') + '\"');",
              "pm.sendRequest(mailpit + '/api/v1/search?limit=1&query=' + query, (err, res) => {",
              "  const list = err ? [] : res.json().messages || [];",
              "  if (!list.length) { console.warn('Mailpit: chưa có email nào cho địa chỉ này'); return; }",
              "  pm.sendRequest(mailpit + '/api/v1/message/' + list[0].ID, (err2, res2) => {",
              "    const match = err2 ? null : (res2.json().Text || '').match(/\\b\\d{6}\\b/);",
              "    if (match) { pm.collectionVariables.set('code', match[0]); console.log('Mailpit: đã lấy mã'); }",
              "    else console.warn('Mailpit: không thấy mã 6 số trong email');",
