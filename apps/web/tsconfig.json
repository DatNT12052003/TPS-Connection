{
  "extends": "@tps/config/tsconfig/react.json",
  "include": ["app", "test", "*.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"],
    // Kiểu sinh tự động của React Router (./+types/<route>) nằm ở .react-router/types.
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./app/*"] }
  }
}
