# Cấu hình web cho máy local. Chép thành apps/web/.env:  cp apps/web/.env.example apps/web/.env
# Không bắt buộc: thiếu tệp thì dùng giá trị mặc định (chính là các giá trị dưới đây).

# Địa chỉ API mà server web (SSR, loader) gọi tới.
API_URL=http://127.0.0.1:3000
# Địa chỉ API mà trình duyệt gọi tới (biến VITE_ được đưa vào mã chạy trên trình duyệt; không đặt bí mật ở đây).
VITE_API_URL=http://127.0.0.1:3000

# Chỉ dùng cho `npm start` (chạy bản build). Dev server luôn chạy ở http://localhost:5173.
# localhost (không phải 127.0.0.1): khớp CORS_ORIGINS của API.
HOST=localhost
PORT=5173
