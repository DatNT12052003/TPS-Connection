{
  "name": "tps-connection",
  "version": "0.0.0",
  "private": true,
  "description": "Nền tảng kết nối gia sư, phụ huynh và học sinh.",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@tps/config/prettier",
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~5.9"
  }
}
