# Ghi đè cấu hình Docker Compose cho máy local. Không bắt buộc: thiếu tệp .env thì dùng giá trị mặc định
# trong compose.yaml (chính là các giá trị dưới đây). Chép thành .env khi cần đổi, ví dụ cổng bị trùng.

POSTGRES_USER=tps
POSTGRES_PASSWORD=tps_dev_password
POSTGRES_DB=tps
# 5433 thay vì 5432 để không trùng PostgreSQL cài sẵn trên máy.
POSTGRES_PORT=5433

REDIS_PORT=6379

# SeaweedFS: API S3 và giao diện xem tệp. Khóa truy cập S3 nằm ở docker/seaweedfs/s3.json.
S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888

# Mailpit: SMTP và giao diện xem email.
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
